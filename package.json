{
  "name": "kiko",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:extension": "bun run --cwd apps/extension dev",
    "dev:companion": "bun run apps/companion/src/index.ts",
    "build": "bun run --cwd apps/extension build && bun run --cwd apps/extension build:firefox",
    "typecheck": "bun run --cwd apps/extension typecheck && tsc -p apps/companion/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "type": "module"
}
